{
  "name": "what-country",
  "version": "2.0.0",
  "description": "Query country data by name, iso code, tld, currency, citizenship, phone, etc",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json --declarationMap false",
    "build:esm": "tsc -p tsconfig.esm.json --declarationMap false",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdacjs/what-country.git"
  },
  "keywords": [
    "country",
    "iso",
    "tld"
  ],
  "author": "Juan Convers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webdacjs/what-country/issues"
  },
  "homepage": "https://github.com/webdacjs/what-country#readme",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
